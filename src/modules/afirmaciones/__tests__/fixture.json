{
  "afirmaciones": [
    {
      "id": "A001",
      "texto": "El módulo debe aceptar un documento JSON pegado directamente sin requerir carga de archivos.",
      "tipo": "requisito",
      "origen": "usuario",
      "estado": "vigente",
      "fuentes": ["MSG-01"],
      "evolucion": {
